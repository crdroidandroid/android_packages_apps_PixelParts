typeattribute pixelparts_app coredomain;
typeattribute pixelparts_app mlstrustedsubject;

app_domain(pixelparts_app)

# app_domain() grants no service access of its own.
allow pixelparts_app app_api_service:service_manager find;

# carrier_config, isub and phone are radio_service, not app_api_service.
allow pixelparts_app radio_service:service_manager find;

allow pixelparts_app system_app_data_file:dir create_dir_perms;
allow pixelparts_app system_app_data_file:{ file lnk_file } create_file_perms;
allow pixelparts_app system_data_file:dir search;

# Traversal only. hbm_mode itself is relabeled away from sysfs_leds by the
# vendor half of this policy, because coredomain.te neverallows every
# coredomain but init, apexd, ueventd, vold and system_app on sysfs_leds:file.
# The dir class is not covered by that neverallow.
allow pixelparts_app sysfs_leds:dir r_dir_perms;
